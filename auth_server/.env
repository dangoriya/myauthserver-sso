# Central Auth Server Environment Configuration
ENV=development
SECRET_KEY=super-secret-jwt-signing-key-change-in-production-123456789
JWT_ALGORITHM=RS256

# Postgres DB Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db
POSTGRES_HOST=postgresdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgresdb:5432/auth_db

# Redis Config
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Base URLs & Redirection Links
AUTH_SERVER_URL=http://localhost:8000
MANAGEMENT_URL=http://localhost:3005
CENTRAL_DASHBOARD_URL=http://localhost:3005
SUCCESSFUL_SIGNUP_REDIRECT_URL=http://localhost:3005
LOGOUT_REDIRECT_URL=http://localhost:3005


