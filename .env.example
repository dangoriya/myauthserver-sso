# =============================================================
# Sensitive Secrets — copy to .env and fill in real values.
# Only password/key values go here; keep this file out of git.
# =============================================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_secure_pg_password
POSTGRES_DB=auth_db
POSTGRES_HOST=shared-postgres-xcoeqe
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme_secure_pgadmin_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_secure_redis_password

# Public App URLs & Ports
# Local Development defaults:
AUTH_SERVER_PORT=9000
AUTH_SERVER_URL=http://localhost:9000
MANAGEMENT_URL=http://localhost:3005
CLIENT1_URL=http://localhost:3001
# Production (Dokploy) example:
# AUTH_SERVER_URL=https://auth.dilipdangoriya.com.np
# MANAGEMENT_URL=https://manage.dilipdangoriya.com.np
# CLIENT1_URL=https://app1.dilipdangoriya.com.np

# SMTP credentials
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=changeme_smtp_password

# Brevo (Sendinblue) API key — only needed when EMAIL_PROVIDER=brevo_api
BREVO_API_KEY=changeme_brevo_api_key

# OIDC client secret for test_client_app1
CLIENT_SECRET=changeme_client_secret

# JWT signing key (used as fallback if no RSA keypair is mounted)
SECRET_KEY=changeme_jwt_signing_key
