# ==============================================================================
# IAM Auth Server & Management Portal — Environment Variables Template
# Copy this file to .env for local testing, or paste into Dokploy Environment UI
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Application Domains
# ------------------------------------------------------------------------------
# Set to your live HTTPS production domains in Dokploy (no trailing slashes)
AUTH_SERVER_URL=https://auth.example.com
MANAGEMENT_URL=https://iam.example.com

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection URL (preferred)
DATABASE_URL=postgresql://admin:your_secure_password@shared-postgres:5432/auth_db

# Option B: Individual connection params (used if DATABASE_URL is not set)
POSTGRES_HOST=shared-postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=auth_db

# ------------------------------------------------------------------------------
# 3. Cache & Session Store (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# ------------------------------------------------------------------------------
# 4. Security & JWT Settings
# ------------------------------------------------------------------------------
# Random 64+ char secret string used for JWT signature fallbacks
SECRET_KEY=generate_a_random_long_secret_key_here_for_production_security

# Database re-seed on startup: MUST BE "false" IN PRODUCTION to prevent data loss!
RESET_DB=false

# OIDC Backchannel Logout 1.0 (true / false)
BACKCHANNEL_LOGOUT_ENABLED=false

# Global Post-Logout Redirect URL
# When a client has no post_logout_redirect_uris registered, RP-initiated
# logout redirects here (e.g. a landing / "signed out" page).
POST_LOGOUT_REDIRECT_URL=https://dilipdangoriya.com.np

# ------------------------------------------------------------------------------
# 5. Email Service (Password Reset & 2FA OTPs)
# ------------------------------------------------------------------------------
# Provider: "smtp" or "brevo_api"
EMAIL_PROVIDER=smtp

# SMTP Relay (Brevo / SendGrid / Mailgun / AWS SES)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login_username
SMTP_PASSWORD=your_smtp_login_password
SMTP_USE_TLS=true

# Brevo API (only needed if EMAIL_PROVIDER=brevo_api)
BREVO_API_KEY=

# Sender Identity
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=IAM Identity Center
