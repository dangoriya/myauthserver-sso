# ==============================================================================
# IAM Auth Server & Management Portal — Environment Variables (.env)
# ==============================================================================

# Public Application Domains
AUTH_SERVER_URL=http://localhost:8005
MANAGEMENT_URL=http://localhost:3005

# Global Post-Logout Redirect URL
# When a client has no post_logout_redirect_uris registered, RP-initiated
# logout redirects here (e.g. a landing / "signed out" page).
POST_LOGOUT_REDIRECT_URL=http://localhost:8005

# Database (PostgreSQL)
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=auth_db

# Cache & Session Store (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=password

# Security & Master Keys
SECRET_KEY=fkfdsk224ghkiiuu4h
RESET_DB=true
BACKCHANNEL_LOGOUT_ENABLED=false

# Email Service
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=example@smtp-brevo.com
SMTP_PASSWORD=password
SMTP_USE_TLS=true
BREVO_API_KEY=changeme_brevo_api_key
EMAIL_FROM=example@gmail.com
EMAIL_FROM_NAME=IAM
